# Path to the data directory (relative to the repo root, or absolute).
# Set this if you have the private data repo cloned locally.
# Copy this file to .env.local and update the path.
#
# Example (dragon-traveler-data cloned as a sibling to this repo):
# DATA_DIR=../dragon-traveler-data/data
DATA_DIR=data

# Base URL for assets in dev (the serveAssetsDir middleware serves them under /assets/).
# In production, VITE_ASSETS_BASE is set to the R2 CDN URL via GitHub Actions.
VITE_ASSETS_BASE=/assets

# To switch data branches locally, just run:
#   git -C /path/to/dragon-traveler-data checkout <branch>
# No env var needed — DATA_DIR points at the folder, branch is implicit.
#
# To trigger a deploy against a specific data branch from CI, use
# "Run workflow" on GitHub Actions and set the data_branch input.
